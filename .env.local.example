# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to git.

# SMTP server host (e.g. smtp.gmail.com, mail.yourhost.com)
SMTP_HOST=smtp.example.com

# SMTP port: 587 for TLS (recommended), 465 for SSL, 25 for unencrypted
SMTP_PORT=587

# SMTP credentials
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password

# Recipient for booking notifications (your team inbox)
BOOKING_EMAIL_TO=info@letempsdunfut.ca
